# ── Razorpay (payments) ─────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test keys first (rzp_test_...), switch to live keys (rzp_live_...) later.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (receipt + enquiry emails) ───────────────────────────
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email addresses ─────────────────────────────────────────────
# Where payment notifications + contact enquiries are sent (you/owner)
ADMIN_EMAIL=vaibhavsawroop@gmail.com
# Sender address. On Resend free tier use onboarding@resend.dev,
# or your verified domain e.g. orders@mentorax.in
FROM_EMAIL=MentoraX Orders <orders@mentorax.in>
