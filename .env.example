# ── Razorpay (payments) ─────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test keys first (rzp_test_...), switch to live keys (rzp_live_...) later.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (receipt + enquiry emails) ───────────────────────────
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email addresses ─────────────────────────────────────────────
# Where payment notifications + contact enquiries are sent (you/owner)
ADMIN_EMAIL=vaibhavsawroop@gmail.com
# Sender address for order receipts. Its domain must be verified inside
# Resend, otherwise every send is rejected. The handler logs the provider
# message and retries from Resend's sandbox sender as a fallback.
FROM_EMAIL=MentoraX Orders <orders@mentoraxs.com>
# Optional: separate sender for website enquiries (defaults to FROM_EMAIL)
# CONTACT_FROM_EMAIL=MentoraX Support <support@mentoraxs.com>

# ── WhatsApp batch invites ──────────────────────────────────────
# Emailed to a student once a batch payment is verified.
WA_LINK_GENESIS=https://chat.whatsapp.com/xxxxxxxxxxxxxxxx
WA_LINK_QUANTUM=https://chat.whatsapp.com/xxxxxxxxxxxxxxxx
WA_LINK_CATALYST=https://chat.whatsapp.com/xxxxxxxxxxxxxxxx

# ── Offline payment simulation (local development only) ─────────
# Leave unset in production. When true, /api/payment/create-order returns a
# mock order instead of a real Razorpay one and the checkout shows a clearly
# labelled demo receipt: no money moves, no email is sent.
# ALLOW_MOCK_PAYMENTS=false
